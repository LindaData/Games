// Windows (x64) depot: everything in steam/content/windows/ goes to the root of the install
// folder. Launch option in Steamworks: SnailmateChess.exe
"DepotBuild"
{
	"DepotID" "{{DEPOT_WIN}}"
	"FileMapping"
	{
		"LocalPath" "windows/*"
		"DepotPath" "."
		"Recursive" "1"
	}
	"FileExclusion" "*.pdb"
}

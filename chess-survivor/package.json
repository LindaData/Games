{
  "name": "chess-survivor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chess Survivor — a roguelike where you are one chess piece trapped inside a real chess game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "balance": "BALANCE=1 vitest run tests/balance.sim.ts tests/edge.sim.ts"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
